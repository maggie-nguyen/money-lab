DATABASE_URL=postgres://moneylab:moneylab@127.0.0.1:5544/moneylab
# Production (Neon): use -pooler host for DATABASE_URL, direct host for DIRECT_URL
DIRECT_URL=postgres://moneylab:moneylab@127.0.0.1:5544/moneylab
AUTH_SECRET=dev-secret-change-me-please-64-bytes-minimum-aaaaaaaaaaaaaaaaaaaaaaaa
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
# Same client id, exposed to the browser so the Google button can render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Maps JavaScript API — restrict key to your domain in Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for custom markers (AdvancedMarker). Create in Cloud Console → Map Management, or use DEMO_MAP_ID locally.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Override only for tests / a local stub of Google's key set
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
RESEND_API_KEY=
# Optional. Leave empty unless manually invoking the dormant maintenance route.
CRON_SECRET=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Must stay false anywhere real accounts exist: it is the only thing standing
# between a password list and the login route. Local development and the e2e
# suite set it to true so repeated runs do not lock themselves out.
RATE_LIMIT_DISABLED=false
SEED_ADMIN_EMAIL=admin@moneylab.local
SEED_ADMIN_PASSWORD=admin12345
SEED_LEARNER_EMAIL=learner@moneylab.local
SEED_LEARNER_PASSWORD=learner12345
# Set to true only for local LMS regression — never in production
SEED_LEGACY=false
ANTHROPIC_API_KEY=
# Override only for tests / a local stub of the Messages API
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_TUTOR_MODEL=claude-haiku-4-5
AI_TUTOR_DAILY_MSG_LIMIT=50
