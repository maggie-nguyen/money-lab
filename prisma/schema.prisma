// MoneyLab schema — mirrors docs/02-DATA-MODEL.md
//
// DOMAIN A (platform): User, auth tokens, FeatureFlag, Event, AuditLog
// DOMAIN B (v2 product): Food*, SpendingJarPlan, SavingsChallenge*, Article*
// DOMAIN C (legacy LMS, frozen): Track, Course, Lesson, Quiz, Sim*, Tutor*, Shop*
// See docs/09-BACKEND-PLATFORM.md §4.2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  LEARNER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Locale {
  vi
  en
}

enum ArticleCategory {
  GUIDE
  EXPLAINER
  NEWS
  STORY
}

// Blocks are stored as jsonb and validated by blockSchema in
// src/server/schemas/content.ts, so there is no BlockType enum here. A database
// enum would have to be migrated in lockstep with every new block type, and it
// could not describe a block's fields anyway.


enum QuizKind {
  LESSON_CHECK
  COURSE_FINAL
  PLACEMENT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}



enum LedgerReason {
  LESSON_COMPLETE
  COURSE_COMPLETE
  QUIZ_PASS
  QUIZ_PERFECT
  SIM_TURN
  SIM_COMPLETE
  STREAK_BONUS
  DAILY_QUEST
  BADGE_AWARD
  LEADERBOARD_REWARD
  SHOP_PURCHASE
  STREAK_FREEZE_USE
  ADMIN_ADJUST
  REFERRAL
  CHALLENGE_COMPLETE
}

enum BadgeKind {
  PROGRESS
  STREAK
  MASTERY
  SIM
  SPECIAL
}

enum FeedbackKind {
  BUG
  CONTENT_ERROR
  SUGGESTION
  PRAISE
  OTHER
}

enum SurveyQuestionType {
  NPS
  RATING_1_5
  SINGLE_CHOICE
  MULTI_CHOICE
  FREE_TEXT
}

enum CertStatus {
  ACTIVE
  REVOKED
}

enum EmailTokenPurpose {
  verify
  reset
}

// ── Identity & auth ──────────────────────────────────────────────────────────

model User {
  id              String    @id
  email           String?   @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  displayName     String
  avatarKey       String?
  role            Role      @default(LEARNER)
  birthYear       Int?
  province        String?
  localePref      Locale    @default(vi)
  onboardedAt     DateTime?
  lastActiveAt    DateTime  @default(now())
  bannedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  oauthAccounts   OauthAccount[]
  refreshTokens   RefreshToken[]
  emailTokens     EmailToken[]
  xpLedger        XpLedger[]
  coinLedger      CoinLedger[]
  stats           UserStats?
  badges          UserBadge[]
  dailyQuests     DailyQuest[]
  feedback        Feedback[]
  surveyResponses SurveyResponse[]
  spendingJar     SpendingJarPlan?
  foodReviews     FoodReview[]
  userChallenges  UserChallenge[]

  @@index([lastActiveAt])
  @@index([role])
  @@map("user")
}

model OauthAccount {
  id                String @id
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_account")
}

model RefreshToken {
  id        String    @id
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_token")
}

model EmailToken {
  id        String            @id
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_token")
}

model IdempotencyKey {
  id             String   @id
  userId         String
  key            String
  endpoint       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_key")
}

model RateLimit {
  bucket      String
  subjectKey  String
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, subjectKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit")
}

// ── Content catalog ──────────────────────────────────────────────────────────









/// A standalone article: a lesson without progress, XP or a quiz. It reuses the
/// same block union as LessonTranslation, so one renderer covers both.
model Article {
  id              String               @id
  slug            String               @unique
  status          ContentStatus        @default(DRAFT)
  category        ArticleCategory
  coverImageUrl   String?
  readMinutes     Int                  @default(4)
  publishedAt     DateTime?
  authorName      String               @default("MoneyLab")
  contentVersion  Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  translations    ArticleTranslation[]

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@map("article")
}

model ArticleTranslation {
  articleId      String
  locale         Locale
  title          String
  summary        String  @default("")
  seoTitle       String  @default("")
  seoDescription String  @default("")
  blocks         Json    @default("[]")
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale])
  @@map("article_translation")
}




model MediaAsset {
  id         String   @id
  uploaderId String
  url        String
  mimeType   String
  bytes      Int
  width      Int?
  height     Int?
  altText    String?
  createdAt  DateTime @default(now())

  @@map("media_asset")
}

model ContentRevision {
  id         String   @id
  entityType String
  entityId   String
  editorId   String
  action     String
  snapshot   Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("content_revision")
}

// ── Progress ─────────────────────────────────────────────────────────────────





// ── Gamification ─────────────────────────────────────────────────────────────

model XpLedger {
  id        String       @id
  userId    String
  delta     Int
  reason    LedgerReason
  refType   String?
  refId     String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
  @@map("xp_ledger")
}

model CoinLedger {
  id        String       @id
  userId    String
  delta     Int
  reason    LedgerReason
  refType   String?
  refId     String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
  @@map("coin_ledger")
}

model UserStats {
  userId           String    @id
  xpTotal          Int       @default(0)
  level            Int       @default(1)
  coins            Int       @default(0)
  streakCurrent    Int       @default(0)
  streakLongest    Int       @default(0)
  streakLastDate   String?
  streakFreezes    Int       @default(0)
  lessonsCompleted Int       @default(0)
  quizzesPassed    Int       @default(0)
  simsCompleted    Int       @default(0)
  badgesSeenAt     DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Badge {
  id           String             @id
  code         String             @unique
  kind         BadgeKind
  iconKey      String             @default("badge")
  coinReward   Int                @default(0)
  criteria     Json               @default("{}")
  translations BadgeTranslation[]
  users        UserBadge[]

  @@map("badge")
}

model BadgeTranslation {
  badgeId     String
  locale      Locale
  title       String
  description String @default("")
  badge       Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([badgeId, locale])
  @@map("badge_translation")
}

model UserBadge {
  id        String   @id
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badge")
}

model DailyQuest {
  id          String    @id
  userId      String
  questDate   String
  code        String
  targetInt   Int
  progressInt Int       @default(0)
  completedAt DateTime?
  xpReward    Int
  coinReward  Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questDate, code])
  @@map("daily_quest")
}





// ── Simulations ──────────────────────────────────────────────────────────────





// ── Feedback & research ──────────────────────────────────────────────────────

model Feedback {
  id             String       @id
  userId         String?
  kind           FeedbackKind
  screenPath     String?
  entityType     String?
  entityId       String?
  body           String
  screenshotUrl  String?
  appVersion     String?
  resolvedAt     DateTime?
  resolverId     String?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("feedback")
}

model Survey {
  id        String           @id
  slug      String           @unique
  status    ContentStatus    @default(DRAFT)
  audience  Json?
  opensAt   DateTime?
  closesAt  DateTime?
  createdAt DateTime         @default(now())
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("survey")
}

model SurveyQuestion {
  id       String             @id
  surveyId String
  order    Int
  type     SurveyQuestionType
  payload  Json               @default("{}")
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("survey_question")
}

model SurveyResponse {
  id          String   @id
  surveyId    String
  userId      String?
  answers     Json
  submittedAt DateTime @default(now())
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([surveyId, userId])
  @@map("survey_response")
}

// ── Analytics ────────────────────────────────────────────────────────────────

model Event {
  id          BigInt   @id @default(autoincrement())
  userId      String?
  anonymousId String?
  sessionId   String
  name        String
  ts          DateTime
  props       Json     @default("{}")
  appVersion  String?
  platform    String   @default("web")

  @@index([name, ts])
  @@index([userId, ts])
  @@map("event")
}

model DailyStat {
  statDate String
  metric   String
  dims     String  @default("{}")
  value    Decimal

  @@id([statDate, metric, dims])
  @@map("daily_stat")
}

// ── Certificates, audit, ops ─────────────────────────────────────────────────


model AuditLog {
  id         String   @id
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_log")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("feature_flag")
}

model CronRun {
  id    String   @id
  name  String
  ranAt DateTime @default(now())
  ok    Boolean
  note  String?

  @@index([name, ranAt])
  @@map("cron_run")
}

// ── Spending management (hũ chi tiêu) ────────────────────────────────────────

model SpendingJarPlan {
  userId         String   @id
  totalBudgetVnd BigInt
  categories     Json     @default("[]")
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spending_jar_plan")
}

// ── Cheap food map ───────────────────────────────────────────────────────────

enum SchoolKind {
  HIGH_SCHOOL
  UNIVERSITY
  VOCATIONAL
  OTHER
}

enum FoodSpotSource {
  manual
  openstreetmap
  hcmc_opendata
  moet
  wikidata
  foody
}

model FoodCluster {
  id           String                   @id
  slug         String                   @unique
  city         String
  order        Int                      @default(0)
  lat          Float?
  lng          Float?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations FoodClusterTranslation[]
  spots        FoodSpot[]
  schools      School[]

  @@map("food_cluster")
}

model FoodClusterTranslation {
  clusterId   String
  locale      Locale
  name        String
  description String @default("")
  cluster     FoodCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@id([clusterId, locale])
  @@map("food_cluster_translation")
}

model FoodSpot {
  id            String             @id
  clusterId     String
  name          String
  address       String             @default("")
  lat           Float?
  lng           Float?
  avgPriceVnd   BigInt?
  tags          Json               @default("[]")
  note          String             @default("")
  order         Int                @default(0)
  source        FoodSpotSource     @default(manual)
  osmType       String?
  osmId         String?
  sourceRef     String             @default("")
  googlePlaceId String?
  gallery       Json               @default("[]")
  verified      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cluster       FoodCluster        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  reviews       FoodReview[]
  schoolLinks   FoodSpotSchool[]

  @@unique([osmType, osmId])
  @@index([clusterId, order])
  @@index([lat, lng])
  @@index([source])
  @@map("food_spot")
}

model School {
  id           String              @id
  slug         String              @unique
  clusterId    String
  kind         SchoolKind
  lat          Float?
  lng          Float?
  address      String              @default("")
  district     String              @default("")
  source       FoodSpotSource      @default(manual)
  osmType      String?
  osmId        String?
  externalRef  String              @default("")
  order        Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  cluster      FoodCluster         @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  translations SchoolTranslation[]
  spotLinks    FoodSpotSchool[]

  @@unique([osmType, osmId])
  @@index([clusterId, order])
  @@index([lat, lng])
  @@map("school")
}

model SchoolTranslation {
  schoolId  String
  locale    Locale
  name      String
  shortName String @default("")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, locale])
  @@map("school_translation")
}

model FoodSpotSchool {
  spotId         String
  schoolId       String
  isPrimary      Boolean  @default(false)
  walkMinutes    Int?
  distanceMeters Int?
  note           String   @default("")
  spot           FoodSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([spotId, schoolId])
  @@index([schoolId])
  @@map("food_spot_school")
}

model FoodReview {
  id        String   @id
  spotId    String
  userId    String
  rating    Int
  body      String
  priceVnd  BigInt?
  createdAt DateTime @default(now())
  spot      FoodSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spotId, createdAt])
  @@map("food_review")
}

// ── Savings challenges ───────────────────────────────────────────────────────

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model SavingsChallenge {
  id           String                        @id
  code         String                        @unique
  slug         String                        @unique
  durationDays Int
  iconKey      String                        @default("challenge")
  badgeCode    String?
  order        Int                           @default(0)
  status       ContentStatus                 @default(PUBLISHED)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  translations SavingsChallengeTranslation[]
  participations UserChallenge[]

  @@map("savings_challenge")
}

model SavingsChallengeTranslation {
  challengeId  String
  locale       Locale
  title        String
  description  String @default("")
  savingsHint  String @default("")
  challenge    SavingsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, locale])
  @@map("savings_challenge_translation")
}

model UserChallenge {
  id          String          @id
  userId      String
  challengeId String
  status      ChallengeStatus @default(ACTIVE)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  tickDates   Json            @default("[]")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   SavingsChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_challenge")
}
